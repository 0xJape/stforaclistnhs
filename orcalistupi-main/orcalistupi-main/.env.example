# Copy to .env. Keep real credentials out of source control.
GROQ_API_KEY=your_groq_api_key
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
MAKE_WEBHOOK_URL=https://hook.example.make.com/your-webhook-id
# Keep false until real-data validation and governance approval.
MAKE_ALERTS_ENABLED=false
MAKE_WEBHOOK_SECRET=replace_with_a_long_random_shared_secret

GROQ_STT_MODEL=whisper-large-v3-turbo
# Leave GROQ_STT_LANGUAGE unset for automatic multilingual detection.
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy

ORACLIS_API_HOST=127.0.0.1
ORACLIS_API_PORT=8765
ORACLIS_CORS_ORIGIN=http://127.0.0.1:5173
